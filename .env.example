# Copy to .env and fill in. Never commit real values.
APP_ENV=development

# postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Optional locally; required in production (shared rate limits across workers).
REDIS_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
QR_CHALLENGE_TTL_SECONDS=20

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# true in any HTTPS deployment (required in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Format check only; it does not prove a code belongs to a serving corps member.
STATE_CODE_PATTERN=^[A-Z]{2}/\d{2}[A-C]/\d{4,5}$
